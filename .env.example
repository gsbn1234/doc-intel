# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，绝不会被提交到 git。
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
TAVILY_API_KEY=tvly-你的TavilyKey

# ========== 可选：LangSmith 全链路追踪（https://smith.langchain.com） ==========
# 想开启：① 把 LANGSMITH_TRACING 改为 true；② 填入真实 API Key
# （注册后 Settings → API Keys 生成，lsv2_ 开头）。
# 不填 Key 或保持 false，程序会静默关闭追踪，不影响任何功能。
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=lc-course

# ========== 可选：MySQL（对话记忆 / 长期记忆持久化） ==========
# 不配也能跑：默认连本机 localhost:3306。连不上时健康检查报 degraded，HTTP 仍是
# 200，问答不受影响（记忆暂时退回进程内存）。
#
# 注意 MYSQL_HOST 的两种场景：
#   · 本机直跑（uvicorn）：用下面这个 localhost，连你自己装的 MySQL 8.0
#   · docker compose：compose 会把它覆盖成服务名 mysql，这里的值不生效
#
# 本机首次使用需要先建库和账号（容器那边由 MYSQL_DATABASE / MYSQL_USER 自动建）：
#   CREATE DATABASE doc_intel CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'doc_app'@'localhost' IDENTIFIED BY '<下面的 MYSQL_PASSWORD>';
#   GRANT ALL PRIVILEGES ON doc_intel.* TO 'doc_app'@'localhost';
# 字符集必须在这里定死 —— langgraph 的 DSN 解析会静默丢弃 ?charset=utf8mb4。
# 只授权 doc_intel.*，不要图省事给全局或直接用 root 跑应用。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=doc_app
MYSQL_PASSWORD=
MYSQL_DATABASE=doc_intel

# 仅 docker compose 使用（本机直跑不读它）：MySQL 容器的 root 密码。
# 必须与 MYSQL_PASSWORD 不同 —— 两者同源的话，应用凭据一泄露 root 也跟着泄露。
# 故意不留默认值：没配就让 compose 当场报错，而不是悄悄退化成一个更弱的配置。
# 本机直跑可以留空。
MYSQL_ROOT_PASSWORD=
